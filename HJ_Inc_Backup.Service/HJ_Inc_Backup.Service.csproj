<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HJ_Inc_Backup.Service</RootNamespace>
    <Company>Eldvor Technologies</Company>
    <Product>Eldvor Guardian</Product>
    <Authors>Eldvor Technologies</Authors>
    <AssemblyName>Eldvor Guardian.Service</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <BaseOutputPath>bin\</BaseOutputPath>
    <ProduceReferenceAssembly>True</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HJ_Inc_Backup.Core\HJ_Inc_Backup.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Licence.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

 </Project>
<Window x:Class="HJ_Inc_Backup.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore Backup"
        Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Select a backup to restore"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- Backup list -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="8">
            <ListView x:Name="LstBackups"
                      SelectionMode="Single"
                      BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Date / Time" Width="160"
                                        DisplayMemberBinding="{Binding DisplayDate}"/>
                        <GridViewColumn Header="Type" Width="90"
                                        DisplayMemberBinding="{Binding Type}"/>
                        <GridViewColumn Header="Files" Width="70"
                                        DisplayMemberBinding="{Binding FileCount}"/>
                        <GridViewColumn Header="Folder" Width="320"
                                        DisplayMemberBinding="{Binding FolderName}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Target path -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Restore to (XAMPP root)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DockPanel>
                <Button x:Name="BtnBrowseTarget" Content="Browse..." Width="90"
                        DockPanel.Dock="Right" Margin="8,0,0,0"
                        Click="BtnBrowseTarget_Click"/>
                <TextBox x:Name="TxtTargetPath" Height="28" VerticalContentAlignment="Center"/>
            </DockPanel>

            <CheckBox x:Name="ChkStopServices"
                      Content="Stop XAMPP services before restore and start them afterwards (recommended)"
                      IsChecked="True"
                      Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnRestore" Content="Restore Selected" Width="140" Height="34"
                    Margin="0,0,10,0" Click="BtnRestore_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
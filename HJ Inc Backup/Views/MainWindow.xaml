<Window x:Class="HJ_Inc_Backup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HJ Incremental XAMPP Backup"
        Height="780"
        Width="980"
        MinHeight="640"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="#F5F5F5">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="HJ Incremental XAMPP Backup"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

        <!-- Source / Destination -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="6"
                Padding="16"
                Margin="0,0,0,15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="XAMPP Root Folder"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtSourcePath"
                             Grid.Column="0"
                             Height="30"
                             VerticalContentAlignment="Center"
                             Text="C:\xampp"/>

                    <Button x:Name="BtnBrowseSource"
                            Grid.Column="2"
                            Width="95"
                            Height="30"
                            Content="Browse..."
                            Click="BtnBrowseSource_Click"/>
                </Grid>

                <TextBlock Grid.Row="3"
                           Text="Backup Destination"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtDestPath"
                             Grid.Column="0"
                             Height="30"
                             VerticalContentAlignment="Center"/>

                    <Button x:Name="BtnBrowseDest"
                            Grid.Column="2"
                            Width="95"
                            Height="30"
                            Content="Browse..."
                            Click="BtnBrowseDest_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Backup buttons -->
        <WrapPanel Grid.Row="2"
                   Margin="0,0,0,12"
                   HorizontalAlignment="Left">

            <Button x:Name="BtnFullBackup"
                    Width="140"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Full Backup"
                    Click="BtnFullBackup_Click"/>

            <Button x:Name="BtnIncrementalBackup"
                    Width="170"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Incremental Backup"
                    Click="BtnIncrementalBackup_Click"/>

            <Button x:Name="BtnRestore"
                    Width="120"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Restore..."
                    Click="BtnRestore_Click"/>

            <Button x:Name="BtnCancel"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    IsEnabled="False"
                    Click="BtnCancel_Click"/>
        </WrapPanel>

        <!-- Windows Service controls -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Backup Windows Service"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtServiceStatus"
                               Text="Status: Unknown"
                               Foreground="#555555"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="BtnServiceInstall"
                            Width="90"
                            Height="32"
                            Margin="0,0,6,0"
                            Content="Install"
                            Click="BtnServiceInstall_Click"/>

                    <Button x:Name="BtnServiceUninstall"
                            Width="90"
                            Height="32"
                            Margin="0,0,6,0"
                            Content="Uninstall"
                            Click="BtnServiceUninstall_Click"/>

                    <Button x:Name="BtnServiceStart"
                            Width="80"
                            Height="32"
                            Margin="0,0,6,0"
                            Content="Start"
                            Click="BtnServiceStart_Click"/>

                    <Button x:Name="BtnServiceStop"
                            Width="80"
                            Height="32"
                            Content="Stop"
                            Click="BtnServiceStop_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Progress / Log -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="6"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="TxtStatus"
                               Text="Ready"
                               FontWeight="SemiBold"/>

                    <ProgressBar x:Name="ProgressBar"
                                 Height="20"
                                 Margin="0,6,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"/>

                    <TextBlock x:Name="TxtProgressDetail"
                               Margin="0,5,0,0"
                               Foreground="#555555"/>
                </StackPanel>

                <TextBox x:Name="TxtLog"
                         Grid.Row="2"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="5"
                   Margin="0,12,0,0"
                   FontSize="11"
                   Foreground="#666666"
                   Text="Note: This application requires Administrator rights (Volume Shadow Copy + service install)." />

    </Grid>
</Window>
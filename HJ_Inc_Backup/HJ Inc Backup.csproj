<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Eldvor Guardian</AssemblyName>
    <RootNamespace>HJ_Inc_Backup</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Eldvor Technologies</Company>
    <Product>Eldvor Guardian</Product>
    <Authors>Eldvor Technologies</Authors>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>j5lmr.ico</ApplicationIcon>
    <PackageIcon>j5lmr.jpg</PackageIcon>
    <StartupObject>HJ_Inc_Backup.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="j5lmr.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Resource Include="background.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Downloads\j5lmr.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HJ_Inc_Backup.Core\HJ_Inc_Backup.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="How to use.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Licence.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
<Application x:Class="HJ_Inc_Backup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="views/MainWindow.xaml">

    <Application.Resources>
        <!-- Colors -->
        <Color x:Key="Orange500">#FFF97316</Color>
        <Color x:Key="Orange600">#FFEA580C</Color>
        <Color x:Key="Orange400">#FFFB923C</Color>
        <Color x:Key="Amber400">#FFFBBF24</Color>
        <Color x:Key="Amber500">#FFF59E0B</Color>

        <Color x:Key="DeepBlack">#FF0A0A0F</Color>
        <Color x:Key="DarkSlate">#FF0F172A</Color>
        <Color x:Key="Slate800">#FF1E293B</Color>
        <Color x:Key="Slate700">#FF334155</Color>

        <Color x:Key="Slate200">#FFE2E8F0</Color>
        <Color x:Key="WhiteColor">#FFFFFFFF</Color>
        <Color x:Key="Slate400">#FF94A3B8</Color>
        <Color x:Key="Slate500">#FF64748B</Color>

        <Color x:Key="AlmostWhite">#FFF8FAFC</Color>
        <Color x:Key="LightGray">#FFE2E8F0</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="Brush_Orange500" Color="{StaticResource Orange500}"/>
        <SolidColorBrush x:Key="Brush_Orange600" Color="{StaticResource Orange600}"/>
        <SolidColorBrush x:Key="Brush_Orange400" Color="{StaticResource Orange400}"/>
        <SolidColorBrush x:Key="Brush_Amber400" Color="{StaticResource Amber400}"/>
        <SolidColorBrush x:Key="Brush_Amber500" Color="{StaticResource Amber500}"/>

        <SolidColorBrush x:Key="Brush_DeepBlack" Color="{StaticResource DeepBlack}"/>
        <SolidColorBrush x:Key="Brush_DarkSlate" Color="{StaticResource DarkSlate}"/>
        <SolidColorBrush x:Key="Brush_Slate800" Color="{StaticResource Slate800}"/>
        <SolidColorBrush x:Key="Brush_Slate700" Color="{StaticResource Slate700}"/>

        <SolidColorBrush x:Key="Brush_Slate200" Color="{StaticResource Slate200}"/>
        <SolidColorBrush x:Key="Brush_White" Color="{StaticResource WhiteColor}"/>
        <SolidColorBrush x:Key="Brush_Slate400" Color="{StaticResource Slate400}"/>
        <SolidColorBrush x:Key="Brush_Slate500" Color="{StaticResource Slate500}"/>

        <SolidColorBrush x:Key="Brush_AlmostWhite" Color="{StaticResource AlmostWhite}"/>
        <SolidColorBrush x:Key="Brush_LightGray" Color="{StaticResource LightGray}"/>

        <!-- Gradients -->
        <LinearGradientBrush x:Key="TitleGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource AlmostWhite}" Offset="0"/>
            <GradientStop Color="{StaticResource LightGray}" Offset="0.4"/>
            <GradientStop Color="{StaticResource Orange500}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource Orange600}" Offset="0"/>
            <GradientStop Color="{StaticResource Orange500}" Offset="1"/>
        </LinearGradientBrush>

        <!-- App background image -->
        <ImageBrush x:Key="AppBackgroundBrush" ImageSource="background.jpg" Stretch="UniformToFill" Opacity="0.12" />

        <!-- Styles -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush_Slate200}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="HeadingText">
            <Setter Property="Foreground" Value="{StaticResource Brush_White}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#AA000000" BlurRadius="6" Direction="270" ShadowDepth="2" Opacity="0.75"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryButtonGradient}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush_White}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush_Orange600}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Brush_Slate700}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush_Slate200}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush_Slate800}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style TargetType="Border" x:Key="CardBorder">
            <Setter Property="Background" Value="{StaticResource Brush_DarkSlate}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource Brush_Orange400}"/>
            <Setter Property="Background" Value="{StaticResource Brush_Slate800}"/>
            <Setter Property="Height" Value="18"/>
        </Style>

    </Application.Resources>

</Application>
